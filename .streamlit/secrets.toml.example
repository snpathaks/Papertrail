# Copy to .streamlit/secrets.toml for local use,
# or paste into Streamlit Community Cloud -> App settings -> Secrets.
# NEVER commit the real secrets.toml (it is already in .gitignore).

LLM_PROVIDER   = "groq"            # ollama | groq | gemini
GROQ_API_KEY   = "gsk_..."         # https://console.groq.com/keys
GROQ_MODEL     = "openai/gpt-oss-20b"

# GEMINI_API_KEY = "AIza..."       # https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY = "AIza..."
# GEMINI_MODEL   = "gemini-2.5-flash"

VECTOR_BACKEND = "memory"          # memory | chroma
CONTACT_EMAIL  = "you@example.com"
