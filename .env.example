# ==============================================================================
# PaperTrail Environment Configuration Template
# Copy this file to .env and fill in your values as needed.
# ==============================================================================

# LLM Provider Selection
# Options: "ollama" (local, default) | "groq" (cloud deployable) | "gemini" (cloud deployable)
LLM_PROVIDER=ollama

# Vector Store Backend
# Options: "memory" (NumPy in-memory, recommended for Streamlit Cloud) | "chroma" (local persistent ChromaDB)
VECTOR_BACKEND=memory

# ------------------------------------------------------------------------------
# 1. Local Inference (Ollama)
# ------------------------------------------------------------------------------
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Cloud Inference (Groq - Recommended for Free Streamlit Cloud Hosting)
# Get a free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 3. Cloud Inference (Google Gemini)
# Get a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Embeddings (FastEmbed - used automatically when provider != ollama)
# ------------------------------------------------------------------------------
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# 5. Academic Search APIs
# Polite-pool email for OpenAlex (grants faster rate limits)
# ------------------------------------------------------------------------------
CONTACT_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# 6. Operational Limits & Timeouts
# ------------------------------------------------------------------------------
PDF_DOWNLOAD_TIMEOUT=30
PDF_MAX_SIZE_MB=15
